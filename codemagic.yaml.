
workflows:
  android-build:
    name: UZFIR Extractor APK
    max_build_duration: 60
    instance_type: linux_x2

    environment:
      flutter: stable

    scripts:
      - name: Extract project
        script: |
          mkdir -p source
          unzip -q "Extractor baza1.zip" -d source
          cd source/flutter_extractor_app
          flutter pub get

      - name: Build release APK
        script: |
          cd source/flutter_extractor_app
          flutter build apk --release

    artifacts:
      - source/flutter_extractor_app/build/app/outputs/flutter-apk/*.apk
